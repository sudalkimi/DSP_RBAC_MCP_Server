<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for STDERR to avoid interfering with MCP protocol -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender (optional) -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/alkimi-dsp-mcp.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/alkimi-dsp-mcp.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger for Alkimi DSP MCP - set to DEBUG for more info -->
    <logger name="com.alkimi.dsp" level="INFO"/>

    <!-- Root logger -->
    <root level="WARN">
        <appender-ref ref="STDERR"/>
        <!-- Uncomment to enable file logging -->
        <!-- <appender-ref ref="FILE"/> -->
    </root>
</configuration>