# Alkimi DSP MCP Server Configuration
alkimi:
  dsp:
    # API configuration
    api-url: ${ALKIMI_DSP_API_URL:https://api.alkimi-dsp.com}
    auth-token: ${ALKIMI_DSP_AUTH_TOKEN:your-auth-token-here}
    
    # Server configuration
    server:
      name: alkimi-dsp-server
      version: 1.0.0
      thread-pool-size: 10

# Spring Boot configuration
spring:
  application:
    name: alkimi-dsp-mcp-server
  main:
    banner-mode: off
    web-application-type: none

# Logging configuration
logging:
  level:
    root: INFO
    com.alkimi.dsp: DEBUG
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} - %msg%n"